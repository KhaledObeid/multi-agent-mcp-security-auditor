# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
# Optional overrides
MCP_SECURITY_AUDITOR_LLM_MODEL=gemini-3.8-flash
MCP_SECURITY_AUDITOR_EMBED_MODEL=models/gemini-embedding-001
# 1 = scripted agents, no LLM calls (development, tests, baseline)
MCP_SECURITY_AUDITOR_OFFLINE=0
MCP_SECURITY_AUDITOR_MAX_TOOL_ROUNDS=3
# Seconds per LLM request before giving up (the audit then uses rule-based steps)
MCP_SECURITY_AUDITOR_LLM_TIMEOUT_S=30
# Retries per LLM request; each retry on an overloaded model adds tens of seconds
MCP_SECURITY_AUDITOR_LLM_MAX_RETRIES=3
